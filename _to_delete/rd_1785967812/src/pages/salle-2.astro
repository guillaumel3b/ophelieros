---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SETMORE_URL, salles } from '../data/salles';

const salle = salles.find((s) => s.slug === 'salle-2')!;
const fullAddress = `${salle.streetAddress}, ${salle.postalCode} ${salle.addressLocality}`;
const mapsEmbedUrl = `https://www.google.com/maps?q=${encodeURIComponent(fullAddress)}&output=embed`;
const mapsLinkUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(fullAddress)}`;

// Schéma LocalBusiness pour cette salle — améliore le référencement local (Google).
const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': 'ExerciseGym',
  name: `Ophélie Ros Pilates — ${salle.name}`,
  description: `Cours de Pilates avec Ophélie Ros à ${salle.arrondissement} (${fullAddress}).`,
  address: {
    '@type': 'PostalAddress',
    streetAddress: salle.streetAddress,
    addressLocality: salle.addressLocality,
    postalCode: salle.postalCode,
    addressCountry: 'FR',
  },
};
---

<BaseLayout
  title={`Cours de Pilates ${salle.arrondissement} — ${salle.name}`}
  description={`Cours de Pilates avec Ophélie Ros à ${salle.arrondissement}, ${salle.streetAddress}. ${salle.schedule}. Réservation en ligne.`}
  structuredData={localBusinessSchema}
>
  <section class="section">
    <div class="container">
      <p class="eyebrow">Salle 2</p>
      <h1>{salle.name}</h1>
      <p class="lede">{salle.arrondissement}</p>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container grid grid--2">
      <div>
        <h2>Infos pratiques</h2>
        <ul>
          <li><strong>Adresse :</strong> {fullAddress}</li>
          <li><strong>Cours :</strong> {salle.schedule}
            {salle.scheduleNote && <><br /><em>{salle.scheduleNote}</em></>}
          </li>
          <li><strong>Accès :</strong> <span class="placeholder">[À COMPLÉTER: parking, transports en commun à proximité]</span></li>
        </ul>
        <a href={mapsLinkUrl} target="_blank" rel="noopener" class="btn btn--secondary" style="margin-top: 0.5rem;">
          Ouvrir dans Google Maps
        </a>
        <div style="margin-top: 1.5rem; border-radius: var(--radius); overflow: hidden; border: 1px solid var(--color-line);">
          <iframe
            src={mapsEmbedUrl}
            title={`Carte — ${salle.name}`}
            width="100%"
            height="280"
            style="border: 0; display: block;"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
        </div>
      </div>
      <div class="card">
        <h3>Présentation de la salle</h3>
        <p>
          <span class="placeholder">
            [À COMPLÉTER: description de la salle — ambiance, équipement, capacité]
          </span>
        </p>
        <div class="placeholder" style="display:block; padding: 2rem; text-align: center;">
          [À COMPLÉTER: photo de la salle]
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container" style="text-align: center;">
      <h2>Réserver un cours dans cette salle</h2>
      <p class="lede" style="margin: 0 auto 1.5rem;">
        Toutes les salles se réservent depuis le même calendrier en ligne.
      </p>
      <a href={SETMORE_URL} target="_blank" rel="noopener" class="btn btn--primary">Voir les disponibilités</a>
    </div>
  </section>
</BaseLayout>
