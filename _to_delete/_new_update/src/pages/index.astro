---
import BaseLayout from '../layouts/BaseLayout.astro';
import { salles } from '../data/salles';
import { INSTAGRAM_URL, INSTAGRAM_HANDLE } from '../data/partenaires';
---

<BaseLayout
  title="Ophélie Ros — Pilates"
  description="Cours de Pilates avec Ophélie Ros, professeure certifiée. Renforcement musculaire en douceur, posture, mobilité — réservez votre cours en ligne."
  image="/images/pilates-hero.jpg"
>
  <section class="hero">
    <div class="hero__grid">
      <div class="hero__text">
        <h1>Ophélie Ros</h1>
        <p class="hero__tagline">Professeure de Pilates classique, à Paris.</p>
        <p class="lede">
          Formée 750 heures au Centre 5 à Paris, elle enseigne le Pilates classique sur tapis et
          sur reformer. Cours collectifs dans deux salles parisiennes, cours privés à domicile.
        </p>
        <div class="hero__ctas">
          <a href="/reservation" class="btn btn--primary">Réserver un cours collectif</a>
          <a href="/contact" class="btn btn--secondary">Cours privé à domicile</a>
        </div>
      </div>
      <div class="hero__media">
        <img src="/images/pilates-hero.jpg" alt="Ophélie Ros en plein exercice de Pilates sur reformer" width="1600" height="1069" />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>Cours collectifs, chaque semaine</h2>
      <p class="lede">Cours sur tapis, une fois par semaine dans chacune des deux salles.</p>
      <ul class="salles-list">
        {salles.map((salle) => (
          <li class="salles-list__item">
            <div>
              <h3>{salle.name}</h3>
              <p class="salles-list__meta">{salle.arrondissement} — {salle.schedule}</p>
            </div>
            <a href={`/${salle.slug}`} class="btn btn--secondary">Réserver</a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container cours-prives">
      <div class="cours-prives__text">
        <h2>À domicile, ou pour un événement</h2>
        <p class="lede">
          En complément des cours collectifs, elle se déplace aussi à domicile pour des séances
          individuelles ou en duo, ainsi que pour des événements.
        </p>
        <a href="/contact" class="btn btn--secondary">Me contacter</a>
      </div>
      <div class="cours-prives__media">
        <img src="/images/pilates-prive.jpg" alt="Ophélie Ros en exercice d'étirement sur reformer" width="935" height="1400" loading="lazy" />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container" style="text-align: center;">
      <p class="lede" style="margin: 0 auto 1.5rem; text-align: center;">
        Formation, certifications, expérience — le parcours complet d'Ophélie.
      </p>
      <a href="/a-propos" class="btn btn--secondary">Découvrir son parcours</a>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container instagram-section">
      <h2>Suivez les cours en images</h2>
      <p class="lede" style="margin: 0 auto 1.5rem;">
        <a href={INSTAGRAM_URL} target="_blank" rel="noopener">{INSTAGRAM_HANDLE}</a>
      </p>
      <!--
        Emplacement réservé pour le fil Instagram. Pour l'activer :
        Ophélie récupère, pour chaque publication à mettre en avant, le code d'intégration officiel
        via le bouton "..." → "Intégrer" sur instagram.com, et me l'envoie. Aucune connexion de
        compte ni mot de passe nécessaire.
      -->
      <div class="instagram-grid" aria-hidden="true">
        {Array.from({ length: 6 }).map(() => <div class="instagram-grid__tile" />)}
      </div>
      <a href={INSTAGRAM_URL} target="_blank" rel="noopener" class="btn btn--secondary">Voir le profil</a>
    </div>
  </section>

  <hr class="hairline container" />

  <section class="section">
    <div class="container" style="text-align: center;">
      <h2>Envie d'essayer un cours ?</h2>
      <p class="lede" style="margin: 0 auto 1.5rem; text-align: center;">
        Réservez votre créneau en quelques clics, directement en ligne.
      </p>
      <a href="/reservation" class="btn btn--primary">Réserver maintenant</a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding: 0;
  }

  .hero__grid {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    min-height: clamp(24rem, 62vw, 34rem);
  }

  .hero__text {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(2.5rem, 6vw, 5rem) clamp(1.5rem, 6vw, 4.5rem);
  }

  .hero__tagline {
    font-family: var(--font-heading);
    font-style: italic;
    font-weight: 400;
    font-size: 1.15rem;
    color: var(--color-ink-soft);
    margin: 0 0 1.2rem;
  }

  .hero__ctas {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 1.5rem;
  }

  .hero__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  @media (max-width: 780px) {
    .hero__grid {
      grid-template-columns: 1fr;
      min-height: 0;
    }

    .hero__media {
      order: -1;
      aspect-ratio: 4 / 3;
    }
  }

  .salles-list {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
  }

  .salles-list__item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.5rem 0;
    border-top: 1px solid var(--color-line);
  }

  .salles-list__item:last-child {
    border-bottom: 1px solid var(--color-line);
  }

  .salles-list__item h3 {
    margin: 0 0 0.2rem;
  }

  .salles-list__meta {
    margin: 0;
    color: var(--color-ink-soft);
  }

  .cours-prives {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  .cours-prives__media {
    max-width: 20rem;
    aspect-ratio: 3 / 4;
    margin-left: auto;
    overflow: hidden;
    border-radius: var(--radius);
  }

  .cours-prives__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  @media (max-width: 780px) {
    .cours-prives {
      grid-template-columns: 1fr;
    }

    .cours-prives__media {
      order: -1;
      margin: 0 auto;
    }
  }

  .instagram-section {
    text-align: center;
  }

  .instagram-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 0.5rem;
    max-width: 40rem;
    margin: 0 auto 1.8rem;
  }

  .instagram-grid__tile {
    aspect-ratio: 1;
    background: var(--color-bg);
    border: 1px solid var(--color-line);
  }

  @media (max-width: 640px) {
    .instagram-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
