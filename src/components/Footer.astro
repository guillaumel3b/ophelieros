---
import { INSTAGRAM_URL, INSTAGRAM_HANDLE } from '../data/partenaires';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <div>
      <p class="site-footer__brand">Ophélie Ros — Professeure de Pilates</p>
      <p class="site-footer__contact">
        <span class="placeholder">[À COMPLÉTER: email de contact]</span>
        &nbsp;·&nbsp;
        <span class="placeholder">[À COMPLÉTER: téléphone]</span>
        &nbsp;·&nbsp;
        <a href={INSTAGRAM_URL} target="_blank" rel="noopener">{INSTAGRAM_HANDLE}</a>
      </p>
    </div>
    <nav aria-label="Liens de pied de page" class="site-footer__links">
      <a href="/salle-1">Salle 1</a>
      <a href="/salle-2">Salle 2</a>
      <a href="/reservation">Réservation</a>
      <a href="/contact">Contact</a>
    </nav>
  </div>
  <div class="container">
    <p class="site-footer__legal">© {year} Ophélie Ros. Tous droits réservés.</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-bg-alt);
    border-top: 1px solid var(--color-border);
    padding: 2.5rem 0 1.5rem;
    margin-top: 4rem;
  }

  .site-footer__inner {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
    margin-bottom: 1.5rem;
  }

  .site-footer__brand {
    font-family: var(--font-heading);
    font-weight: 600;
    margin-bottom: 0.3rem;
  }

  .site-footer__contact {
    color: var(--color-ink-soft);
    font-size: 0.92rem;
    margin: 0;
  }

  .site-footer__links {
    display: flex;
    gap: 1.3rem;
    flex-wrap: wrap;
  }

  .site-footer__links a {
    color: var(--color-ink-soft);
    font-size: 0.92rem;
  }

  .site-footer__legal {
    color: var(--color-ink-soft);
    font-size: 0.82rem;
    margin: 0;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border);
  }
</style>
