---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { salles } from '../data/salles';
import { INSTAGRAM_URL } from '../data/partenaires';
import heroImg from '../assets/images/pilates-hero.jpg';
import priveImg from '../assets/images/pilates-prive.jpg';
import instagram1 from '../assets/images/instagram-1.jpg';
import instagram2 from '../assets/images/instagram-2.jpg';
import instagram3 from '../assets/images/instagram-3.jpg';
import instagram4 from '../assets/images/instagram-4.jpg';

// Sélection de photos (envoyées par Ophélie) pour illustrer la section Instagram.
// Toutes renvoient vers le profil général — pas de lien vers un post précis.
const instagramPhotos = [
  { src: instagram1, alt: 'Ophélie en exercice sur reformer' },
  { src: instagram2, alt: 'Reflet dans le miroir du studio, enseigne "Pilates"' },
  { src: instagram3, alt: 'Ophélie en exercice sur reformer, jambes tendues' },
  { src: instagram4, alt: 'Anneau et ballon de Pilates sur un tapis' },
];
---

<BaseLayout
  title="Ophélie Ros — Pilates à Paris"
  description="Cours de Pilates avec Ophélie Ros, professeure certifiée. Renforcement musculaire en douceur, posture, mobilité — réservez votre cours en ligne."
  image="/images/pilates-hero.jpg"
>
  <section class="hero">
    <div class="hero__grid">
      <div class="hero__text">
        <h1>Ophélie Ros</h1>
        <p class="hero__tagline">Professeure de Pilates classique, à Paris.</p>
        <p class="lede">
          J'enseigne le Pilates classique sur tapis et sur appareils. Cours collectifs et cours
          privés à domicile dans Paris.
        </p>
        <div class="hero__ctas">
          <a href="/reservation" class="btn btn--primary">Réserver un cours collectif</a>
          <a href="/contact" class="btn btn--secondary">Cours privé à domicile</a>
        </div>
      </div>
      <div class="hero__media">
        <Image
          src={heroImg}
          alt="Ophélie Ros en plein exercice de Pilates sur reformer"
          widths={[400, 800, 1200, 1600]}
          sizes="(max-width: 780px) 100vw, 50vw"
          quality={82}
          fetchpriority="high"
          loading="eager"
        />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>Cours collectifs, chaque semaine</h2>
      <p class="lede">Cours sur tapis, hebdomadaire dans chacune des deux salles.</p>
      <ul class="salles-list">
        {salles.map((salle) => (
          <li class="salles-list__item">
            <div>
              <h3>{salle.name}</h3>
              <p class="salles-list__meta">{salle.arrondissement} — {salle.schedule}</p>
            </div>
            <a href="/reservation" class="btn btn--secondary">Réserver</a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container cours-prives">
      <div class="cours-prives__text">
        <h2>À domicile, ou pour un événement</h2>
        <p class="lede">
          En complément des cours collectifs, je me déplace aussi à domicile pour des séances
          individuelles ou en duo, ainsi que pour des événements.
        </p>
        <a href="/contact" class="btn btn--secondary">Me contacter</a>
      </div>
      <div class="cours-prives__media">
        <Image
          src={priveImg}
          alt="Ophélie Ros en exercice d'étirement sur reformer"
          widths={[320, 640, 935]}
          sizes="20rem"
          quality={82}
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container" style="text-align: center;">
      <p class="lede" style="margin: 0 auto 1.5rem; text-align: center;">
        Formation, certifications, expérience — mon parcours complet.
      </p>
      <a href="/a-propos" class="btn btn--secondary">Découvrir mon parcours</a>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container instagram-section">
      <div class="instagram-grid">
        {instagramPhotos.map((photo) => (
          <a href={INSTAGRAM_URL} target="_blank" rel="noopener" class="instagram-grid__item">
            <Image src={photo.src} alt={photo.alt} densities={[1, 2]} width={220} quality={80} loading="lazy" />
          </a>
        ))}
      </div>
      <a href={INSTAGRAM_URL} target="_blank" rel="noopener" class="btn btn--secondary">Voir le profil</a>
    </div>
  </section>

  <hr class="hairline container" />

  <section class="section">
    <div class="container" style="text-align: center;">
      <a href="/reservation" class="btn btn--primary">Réserver un cours</a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding: 0;
  }

  .hero__grid {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    min-height: clamp(24rem, 62vw, 34rem);
  }

  .hero__text {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(2.5rem, 6vw, 5rem) clamp(1.5rem, 6vw, 4.5rem);
  }

  .hero__tagline {
    font-family: var(--font-heading);
    font-style: italic;
    font-weight: 400;
    font-size: 1.15rem;
    color: var(--color-ink-soft);
    margin: 0 0 1.2rem;
  }

  .hero__ctas {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 1.5rem;
  }

  .hero__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  @media (max-width: 780px) {
    .hero__grid {
      grid-template-columns: 1fr;
      min-height: 0;
    }

    .hero__media {
      order: -1;
      aspect-ratio: 4 / 3;
    }
  }

  .salles-list {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
  }

  .salles-list__item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.5rem 0;
    border-top: 1px solid var(--color-line);
  }

  .salles-list__item:last-child {
    border-bottom: 1px solid var(--color-line);
  }

  .salles-list__item h3 {
    margin: 0 0 0.2rem;
  }

  .salles-list__meta {
    margin: 0;
    color: var(--color-ink-soft);
  }

  .cours-prives {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  .cours-prives__media {
    max-width: 20rem;
    aspect-ratio: 3 / 4;
    margin-left: auto;
    overflow: hidden;
    border-radius: var(--radius);
  }

  .cours-prives__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  @media (max-width: 780px) {
    .cours-prives {
      grid-template-columns: 1fr;
    }

    .cours-prives__media {
      order: -1;
      margin: 0 auto;
    }
  }

  .instagram-section {
    text-align: center;
  }

  .instagram-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.75rem;
    max-width: 50rem;
    margin: 0 auto 1.8rem;
  }

  .instagram-grid__item {
    display: block;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    border-radius: var(--radius);
    border: 1px solid var(--color-line);
  }

  .instagram-grid__item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease;
  }

  .instagram-grid__item:hover img {
    transform: scale(1.03);
  }

  @media (max-width: 640px) {
    .instagram-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
