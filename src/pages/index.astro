---
import BaseLayout from '../layouts/BaseLayout.astro';
import { salles } from '../data/salles';
---

<BaseLayout
  title="Ophélie Ros — Pilates"
  description="Cours de Pilates avec Ophélie Ros, professeure certifiée. Renforcement musculaire en douceur, posture, mobilité — réservez votre cours en ligne."
  image="/images/pilates-hero.jpg"
>
  <section class="hero">
    <div class="container hero__inner">
      <div class="hero__text">
        <p class="eyebrow">Professeure de Pilates certifiée</p>
        <h1>Retrouvez force, posture et mobilité avec le Pilates</h1>
        <p class="lede">
          Ophélie Ros vous accompagne dans des cours de Pilates en petit groupe, pensés pour
          renforcer votre corps en profondeur, améliorer votre posture au quotidien et retrouver
          une vraie mobilité — quel que soit votre niveau de départ.
        </p>
        <div class="hero__ctas">
          <a href="/reservation" class="btn btn--primary">Réserver un cours</a>
          <a href="/methode-pilates" class="btn btn--secondary">Découvrir la méthode</a>
        </div>
      </div>
      <div class="hero__image">
        <img src="/images/pilates-hero.jpg" alt="Ophélie Ros en plein exercice de Pilates sur reformer" width="1600" height="1069" />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow">Où me trouver</p>
      <h2>Deux salles, deux quartiers</h2>
      <p class="lede">
        Je donne mes cours chaque semaine dans deux salles. Choisissez celle la plus proche de
        chez vous pour voir les horaires et réserver directement.
      </p>
      <div class="grid grid--2" style="margin-top: 2rem;">
        {salles.map((salle) => (
          <div class="card">
            <h3>{salle.name}</h3>
            <p class="site-footer__contact">{salle.arrondissement} — {salle.schedule}</p>
            <a href={`/${salle.slug}`} class="btn btn--secondary">Voir les horaires</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container grid grid--2" style="align-items: center;">
      <div>
        <p class="eyebrow">Cours privés</p>
        <h2>Un accompagnement sur-mesure, solo ou duo</h2>
        <p class="lede">
          Envie d'un suivi individuel, adapté à votre niveau et à vos objectifs ? Je propose aussi
          des cours privés, en solo ou en duo, ainsi que des cours pour vos événements.
        </p>
        <a href="/contact" class="btn btn--secondary">En savoir plus &amp; me contacter</a>
      </div>
      <div class="image-card">
        <img src="/images/pilates-prive.jpg" alt="Ophélie Ros en exercice d'étirement sur reformer" width="935" height="1400" loading="lazy" />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow">Pourquoi le Pilates</p>
      <h2>Une méthode douce, mais exigeante</h2>
      <div class="grid grid--3" style="margin-top: 2rem;">
        <div class="card">
          <h3>Renforcement en profondeur</h3>
          <p>Un travail centré sur les muscles profonds, pour un corps stable et fort au quotidien.</p>
        </div>
        <div class="card">
          <h3>Posture &amp; mobilité</h3>
          <p>Moins de tensions, plus d'amplitude — pour bouger avec aisance à tout âge.</p>
        </div>
        <div class="card">
          <h3>Accessible à tous</h3>
          <p>Des cours adaptés à chaque niveau, du débutant au pratiquant confirmé.</p>
        </div>
      </div>
      <p style="margin-top: 2rem;">
        <a href="/methode-pilates">En savoir plus sur la méthode →</a>
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="card" style="text-align: center; padding: 3rem 2rem;">
        <h2>Envie d'essayer un cours ?</h2>
        <p class="lede" style="margin: 0 auto 1.5rem;">
          Réservez votre créneau en quelques clics, directement en ligne.
        </p>
        <a href="/reservation" class="btn btn--primary">Réserver maintenant</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding: clamp(2.5rem, 6vw, 4.5rem) 0;
    background: linear-gradient(180deg, var(--color-bg-alt) 0%, var(--color-bg) 100%);
  }

  .hero__inner {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  .hero__ctas {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 1.5rem;
  }

  .hero__image img {
    width: 100%;
    height: auto;
    border-radius: var(--radius);
    box-shadow: 0 24px 48px -24px rgba(47, 42, 38, 0.35);
  }

  .image-card {
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: 0 20px 40px -20px rgba(47, 42, 38, 0.3);
  }

  .image-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  @media (max-width: 780px) {
    .hero__inner {
      grid-template-columns: 1fr;
    }

    .hero__image {
      order: -1;
    }
  }
</style>
