---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
// Polices auto-hébergées (via Fontsource) plutôt que chargées depuis fonts.googleapis.com :
// évite une requête tierce bloquante au premier rendu, et un point de dépendance externe en moins.
// Fichiers statiques (pas la version "variable") : le site n'utilise que 2 graisses fixes
// (Newsreader 500 normal pour les titres, Newsreader 400 italique pour la tagline), donc les
// fichiers statiques sont bien plus légers que la police variable (qui encode tout l'intervalle
// de graisses 200-800 même si on n'en utilise qu'une poignée).
import '@fontsource/newsreader/500.css';
import '@fontsource/newsreader/400-italic.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/400-italic.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';

interface Props {
  title: string;
  description: string;
  /** Chemin absolu vers une image de partage (Open Graph), ex: "/images/og-default.jpg" */
  image?: string;
  /** Schéma(s) JSON-LD supplémentaires à injecter sur cette page (LocalBusiness, etc.) */
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
}

const {
  title,
  description,
  image = '/images/pilates-hero.jpg',
  structuredData,
  noindex = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(image, Astro.site);
const siteName = 'Ophélie Ros — Pilates à Paris';
const fullTitle = title === siteName ? title : `${title} · ${siteName}`;

// Schéma de base : la professeure elle-même, présent sur toutes les pages.
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Ophélie Ros',
  jobTitle: 'Professeure de Pilates',
  url: 'https://ophelieros.fr',
  sameAs: ['https://www.instagram.com/ophe._pilates/'],
  worksFor: {
    '@type': 'ExerciseGym',
    name: 'Ophélie Ros — Pilates',
  },
  hasCredential: {
    '@type': 'EducationalOccupationalCredential',
    credentialCategory: 'certificate',
    name: 'Formation complète de Pilates classique (750h)',
    recognizedBy: {
      '@type': 'Organization',
      name: 'Centre 5',
    },
  },
};

const schemas = [
  personSchema,
  ...(structuredData ? (Array.isArray(structuredData) ? structuredData : [structuredData]) : []),
];
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:locale" content="fr_FR" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />

    {schemas.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
  </head>
  <body>
    <a href="#main" class="skip-link">Aller au contenu principal</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
